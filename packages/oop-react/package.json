{
  "name": "oop-react",
  "version": "0.0.0",
  "description": "Object-oriented UI for React: state and behaviour stay in a plain class, and only @OopReactRender() methods re-render.",
  "license": "MIT",
  "keywords": [
    "react",
    "object-oriented",
    "class",
    "decorator",
    "mobx",
    "state-management"
  ],
  "homepage": "https://shijianjs.github.io/oop-react/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shijianjs/oop-react.git",
    "directory": "packages/oop-react"
  },
  "bugs": {
    "url": "https://github.com/shijianjs/oop-react/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "mobx": "^6.12.0 || ^7.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "mobx": "^7.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
