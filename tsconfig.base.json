{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // The library's public decorator is a legacy (`--experimentalDecorators`)
    // method decorator: it has to be usable on a method that returns JSX, and
    // the legacy form is the one whose signature the wrapper can preserve.
    "experimentalDecorators": true,
    "useDefineForClassFields": true
  }
}
